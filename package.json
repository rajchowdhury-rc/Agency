    "motion": "^12.23.24",
    "next": "^16.3.4",
    "postcss": "^8.5.26",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-server-dom-webpack": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "19.2.18",
    "autoprefixer": "^10.4.21",
